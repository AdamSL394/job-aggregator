# Local run only (Option A) -- copy to .env, fill in, never commit the real one.
GEMINI_API_KEY=

# Hosted Postgres connection string (Neon or Supabase free tier).
# Needed locally too once db.py talks to Postgres instead of SQLite.
# In Lambda (Option B), set this as a Lambda environment variable instead --
# Lambda does not read .env files.
DATABASE_URL=

# Lambda only (Option B). Not used locally -- local run reads
# service_account.json from the project root instead. Paste the full
# service account JSON as one line when setting this as a Lambda env var.
# GOOGLE_SERVICE_ACCOUNT_JSON=
